# Copy to .env and fill in real values. .env is git-ignored.
# On the server, deploys rewrite this file from GitHub Actions secrets: the prod
# folder gets the *_PROD keys, the staging folder the *_STAGING keys.
DATABASE_URL_PROD="postgresql://USER:PASSWORD@HOST:25060/pos_db?sslmode=require"
DATABASE_URL_STAGING="postgresql://USER:PASSWORD@HOST:25060/pos_db_staging?sslmode=require"
JWT_SECRET_PROD="change-me-to-a-long-random-string"
JWT_SECRET_STAGING="change-me-to-a-different-long-random-string"
